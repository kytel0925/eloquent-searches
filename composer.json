{
    "name": "sloth-dev-guy/searches",
    "description": "Turn array-like conditions (such as an HTTP query string) into Eloquent queries with wheres, relationship joins, sorting and pagination.",
    "type": "library",
    "keywords": [
        "laravel",
        "eloquent",
        "search",
        "filter",
        "query-builder",
        "database"
    ],
    "homepage": "https://github.com/sloth-dev-guy/searches",
    "license": "MIT",
    "authors": [
        {
            "name": "Telmo Rafael",
            "email": "sloth.dev.guy@gmail.com",
            "homepage": "https://sloth-guy.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SlothDevGuy\\Searches\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SlothDevGuy\\Searches\\EloquentSearchServiceProvider"
            ],
            "aliases": {
                "Searches": "SlothDevGuy\\Searches\\Facades\\Searches"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
